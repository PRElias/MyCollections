@model IEnumerable<MyCollections.Models.Game>

    <div id="overlay" class="coverAll">
        <img src="images/bannerBackgroundImage.gif" class="overlayGif" />
    </div>

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert alert-info margins">@TempData["Mensagem"]</div>
    }

    <div id="mButtons" class="margins">
        <button class="btn btn-primary" id="btn_NewGame"><a href="Games/Create" style="color: white !important;">Novo Jogo</a></button>
        <button class="btn btn-primary" id="btn_AutoNewGames"><a href="/Games/AutoNewGames" style="color: white !important;">Buscar novos jogos</a></button>
        <!-- <button class="btn btn-primary" id="btn_Commit"><a href="Games/Commit" style="color: white !important;">Salvar no Servidor</a></button> -->
        @if (ViewBag.SemLogo == true)
        {
            <button class="btn btn-secondary" id="btn_Todos"><a href="/Games" style="color: white !important;">Ver todos</a></button>
        }
        else
        {
            <button class="btn btn-secondary" id="btn_SemLogo"><a href="/Games?semLogo=true" style="color: white !important;">Sem logo</a></button>
        }
        <button class="btn btn-primary" id="btn_AtualizarLogosSteam"><a href="/Games/AtualizarLogosSteam" style="color: white !important;">Atualizar logos Steam</a></button>
        <button class="btn btn-primary" id="btn_AtualizarDetalhesIgdb"><a href="/Games/AtualizarDetalhesIgdb" style="color: white !important;">Atualizar detalhes IGDB</a></button>
        <button class="btn btn-primary" id="btn_FindOnSteam"><a href="Games/FindGameOnSteam" style="color: white !important;">Recupera SteamID Faltantes <noframes> Steam</noframes></a></button>
    </div>

    <table class="table" id="gamesTable">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Nome
                </th>
                <th>
                    Logo
                </th>
                <th>
                    Loja
                </th>
                <th>
                    Sistema
                </th>
                <th>
                    Status
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => game.GameID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => game.Name)
                </td>
                <td>
                    @if (!String.IsNullOrWhiteSpace(game.LogoURL) && (game.LogoURL.Trim().StartsWith("http", StringComparison.OrdinalIgnoreCase) || game.LogoURL.Trim().StartsWith("games/", StringComparison.OrdinalIgnoreCase) || game.LogoURL.Trim().StartsWith("./games/", StringComparison.OrdinalIgnoreCase)))
                    {
                        <img src="docs/@game.LogoURL.Trim()" class="lazy" style="width: 70px;">
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => game.Store)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => game.System)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => game.Disabled)
                </td>
            </tr>
            }
        </tbody>
    </table>


